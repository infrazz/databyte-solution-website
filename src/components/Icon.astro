---
// Small inline stroke icons (no icon font, no external requests).
type Name = 'lock' | 'recycle' | 'rack' | 'check' | 'shield' | 'phone' | 'mail' | 'whatsapp' | 'arrow' | 'truck' | 'doc' | 'tools' | 'bin' | 'users';
const { name, size = 26 } = Astro.props as { name: Name; size?: number };
---
<svg width={size} height={size} viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'lock' && (<><rect x="5" y="11" width="16" height="11" rx="2"></rect><path d="M9 11V8a4 4 0 0 1 8 0v3"></path><circle cx="13" cy="16.5" r="1.2" fill="currentColor"></circle></>)}
  {name === 'recycle' && (<><path d="M9.5 5.5 7 10l3.5.5"></path><path d="M7 10l2.6-4.4a3 3 0 0 1 5.2 0L17 9.5"></path><path d="M21 15l-2.4 4.5a3 3 0 0 1-2.6 1.5H11"></path><path d="M13 23l-2-2 2-2"></path><path d="M5 15.5 7.2 19.5A3 3 0 0 0 9.8 21"></path><path d="M19.5 9.5l-2.5 0 1-3"></path></>)}
  {name === 'rack' && (<><rect x="4" y="3" width="18" height="6" rx="1.5"></rect><rect x="4" y="10.5" width="18" height="6" rx="1.5"></rect><rect x="4" y="18" width="18" height="5" rx="1.5"></rect><path d="M8 6h.01M8 13.5h.01M8 20.5h.01"></path></>)}
  {name === 'check' && <path d="M5 13.5l5 5 11-12"></path>}
  {name === 'shield' && (<><path d="M13 3l8 3v6.5c0 5-3.6 8.6-8 10.5-4.4-1.9-8-5.5-8-10.5V6z"></path><path d="M9 13l3 3 5-6"></path></>)}
  {name === 'phone' && <path d="M8.5 3.5 6 4.2C4.8 4.6 4 5.8 4.2 7c.9 7.6 7.2 13.9 14.8 14.8 1.2.2 2.4-.6 2.8-1.8l.7-2.5-4.3-2.4-2.1 2.1a12 12 0 0 1-6.6-6.6l2.1-2.1z"></path>}
  {name === 'mail' && (<><rect x="3" y="6" width="20" height="14" rx="2"></rect><path d="M4 7.5l9 6.5 9-6.5"></path></>)}
  {name === 'whatsapp' && (<><path d="M5 21l1.3-4A8.5 8.5 0 1 1 9 19.7z"></path><path d="M10 9.5c.4 2.6 2.2 4.6 5 5.5l1.2-1.2 1.8.8-.5 1.7c-4.4.1-8.4-3.9-8.3-8.3l1.7-.5.8 1.8z" fill="currentColor" stroke="none"></path></>)}
  {name === 'arrow' && <path d="M5 13h15M14 7l6 6-6 6"></path>}
  {name === 'truck' && (<><path d="M3 7h12v10H3zM15 11h4l3 3v3h-7"></path><circle cx="7.5" cy="18.5" r="2"></circle><circle cx="18" cy="18.5" r="2"></circle></>)}
  {name === 'doc' && (<><path d="M7 3h8l5 5v15H7z"></path><path d="M15 3v5h5M10 13h7M10 17h7"></path></>)}
  {name === 'tools' && (<><path d="M14.5 6.5a4 4 0 0 0 5 5l-9 9a2.1 2.1 0 0 1-3-3z"></path><path d="M19 3l-2.5 2.5.5 2.5 2.5.5L22 6"></path></>)}
  {name === 'bin' && (<><path d="M5 7h16M10 7V4h6v3M7 7l1 15h10l1-15"></path><path d="M11 11v7M15 11v7"></path></>)}
  {name === 'users' && (<><circle cx="9" cy="9" r="3.5"></circle><path d="M3 21c.5-3.5 3-5.5 6-5.5s5.5 2 6 5.5"></path><circle cx="18" cy="8" r="2.5"></circle><path d="M17 14c2.6 0 4.6 1.6 5 4.5"></path></>)}
</svg>
