---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import AsideNav from '../../components/AsideNav.astro';
import { IMG } from '../../images';
const path = '/data-sanitization/equipment';
const crumbs = [
  { name: 'Data Sanitization', href: '/data-sanitization' },
  { name: 'Equipment', href: path },
];
---
<Base
  title="Data Sanitization Equipment: NSA/CSS-Evaluated Degausser, Crusher & Shredders"
  description="Databyte Solution uses NSA/CSS-evaluated enterprise equipment: a 20,000 gauss TS-1 degausser, an HDD crusher, and portable SSD and HDD shredders for onsite destruction."
  path={path}
  crumbs={crumbs}
  image={IMG.degausserTs1.src}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Our equipment"
    title="Data Sanitization Equipment"
    lead="NSA/CSS-evaluated, enterprise-grade equipment that ensures complete sanitization of storage media, for our clients' assurance."
  />
  <section class="section section--surface">
    <div class="wrap with-aside">
      <div class="stack-lg">
        <div class="prose">
          <p>
            Databyte Solution employs <a href="https://www.nsa.gov/Resources/Media-Destruction-Guidance/NSA-Evaluated-Products-Lists-EPLs/" rel="noopener">NSA/CSS-evaluated</a>
            enterprise-grade equipment to ensure complete sanitization of storage media.
          </p>
          <p>
            Our portable, lightweight equipment has fast cycle times, which means manpower and logistics savings, and a lower cost
            of service for our customers.
          </p>
        </div>
        <div class="grid grid--2">
          <article class="card card--flush">
            <Photo img={IMG.degausserTs1} alt="Garner TS-1 degausser" class="card-media card-media--contain" />
            <div class="card-body">
              <h3><a href="https://www.nsa.gov/Portals/75/NSAEPLMagneticDegaussersJan2022_1.pdf" rel="noopener">NSA/CSS-evaluated TS-1 degausser</a></h3>
              <p class="muted">Rated at 20,000 gauss (2 tesla).</p>
            </div>
          </article>
          <article class="card card--flush">
            <Photo img={IMG.hddCrusher} alt="Hard disk drive crusher" class="card-media card-media--contain" />
            <div class="card-body">
              <h3><a href="https://www.nsa.gov/Portals/75/NSAEPLHardDiskDriveDestructionDevicesJan2022.pdf" rel="noopener">NSA/CSS-evaluated HDD crusher</a></h3>
              <p class="muted">Destroys HDDs and SSDs.</p>
            </div>
          </article>
          <article class="card card--flush">
            <Photo img={IMG.ssdShredded} alt="Solid state storage shredded into small pieces" class="card-media" />
            <div class="card-body"><h3>Portable SSD shredder</h3><p class="muted">Shreds solid state storage onsite.</p></div>
          </article>
          <article class="card card--flush">
            <Photo img={IMG.hddShredded} alt="Hard disk drives shredded into fragments" class="card-media" />
            <div class="card-body"><h3>HDD shredder</h3><p class="muted">Shreds HDDs and large-format media.</p></div>
          </article>
        </div>
      </div>
      <AsideNav section="/data-sanitization" path={path} />
    </div>
  </section>
  <CtaBand title="See it done at your premises" text="Our equipment is portable and runs from a wall plug, so drives can be destroyed in front of your team." />
</Base>
